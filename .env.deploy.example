# DreamHost SFTP & SSH Deployment Credentials Template
# Copy this file to .env.deploy or inject variables via CI/CD secrets (e.g. GitHub Secrets)
SSH_HOST=your-host.dreamhost.com
SSH_USER=your_ssh_username
SSH_PASSWORD=your_ssh_password
SSH_PORT=22
SSH_TARGET=/home/your_ssh_username/dbas.aredpanic.com
SSH_SERVER_DIR=/home/your_ssh_username/server
