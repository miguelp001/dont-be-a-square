{
  "name": "panel-pon-clone",
  "version": "0.1.0",
  "description": "Tetris Attack / Panel de Pon clone built with Phaser 3, TypeScript, Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "deploy": "npm run build && python scripts/deploy.py"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "socket.io": "^4.7.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
